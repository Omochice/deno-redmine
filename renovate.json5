{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>Omochice/personal-renovate-config#v3.0.0",
    "github>Omochice/personal-renovate-config:nix#v3.0.0",
    "github>Omochice/renovate-config:deno#v4.1.1",
  ],
  packageRules: [
    {
      groupName: "msw",
      matchPackageNames: [
        "msw",
        "@mswjs/interceptors",
      ],
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: [
      "before 3:00am",
    ],
  },
}
