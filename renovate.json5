{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>Omochice/personal-renovate-config#v2.0.0",
    "github>Omochice/personal-renovate-config:nix#v2.0.0",
    "github>Omochice/renovate-config:deno#v4.1.1",
  ],
  packageRules: [
    {
      // _msw.ts pins @mswjs/interceptors directly, and it must stay within
      // the range msw declares or Deno resolves a second copy.
      groupName: "msw",
      matchPackageNames: ["msw", "@mswjs/interceptors"],
    },
  ],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: [
      "before 3:00am",
    ],
  },
}
